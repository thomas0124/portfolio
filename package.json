{
  "name": "frontend_template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:api": "node --import tsx --test worker/api.test.ts",
    "test": "npm run test:api",
    "lint": "next lint --dir app --dir components --dir hooks --dir lib --dir worker",
    "types:worker": "wrangler types worker/env.d.ts --include-runtime false --strict-vars false",
    "format": "prettier --write --ignore-path .gitignore './**/*.{ts,tsx}'",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "i": "^0.3.7",
    "lucide-react": "^0.408.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "react": "^18",
    "react-dom": "^18",
    "react-icon": "^1.0.0",
    "react-icons": "^5.2.1",
    "react-intersection-observer": "^9.16.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.39",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
